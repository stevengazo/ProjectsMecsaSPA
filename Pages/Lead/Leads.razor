@page "/leads"

@inject IDbContextFactory<ProjectsDBContext> DbContextFactory

<AuthorizeView Roles="administrador,ingeniero">
    <Authorized>
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div class="d-flex flex-row justify-content-start align-items-center gap-3">
                <h3 class="mb-0">Prospectos Recepción</h3>

                <div class="flex-grow-1" style="max-width: 320px;">
                    <input type="text"
                           class="form-control"
                           placeholder="Buscar lead..."
                           @bind-value="SearchValue"
                           @bind-value:event="oninput" />
                </div>
            </div>
            


            <button class="btn btn-primary" @onclick="ShowLeadComponent">
                <i class="bi bi-plus-lg me-1"></i>
                Agregar Lead
            </button>
        </div>


        <hr />



        <Tabs>
            <Tab Title="Tabla" >
                <Content>
                    <TableLeadComponent Leads="leads" OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>

            <Tab Title="Etapas" Active="true">
                <Content>
                    <LeadKanban Leads="leads"
                                OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>
            <Tab Title="Reporte">
                <Content>
                    <LeadReportComponent OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>
            <Tab Title="Sector">
                <Content>
                    <Tabs>
                        @foreach (var item in ByCategory)
                        {
                            <Tab Title="@item.Key">
                                <Content>
                                    <TableLeadComponent Leads="@item.Value" OnSelect="HandleLeadSelected" />
                                </Content>
                            </Tab>
                        }

                    </Tabs>
                </Content>
            </Tab>
        </Tabs>

        <Offcanvas @ref="offcanvas" />
    </Authorized>
    <NotAuthorized>

    </NotAuthorized>
</AuthorizeView>




@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success mt-3">
        @message
    </div>
}

@code {

    private Offcanvas offcanvas = default!;
    private string? message;

    private string _searchValue = string.Empty;
    private string SearchValue
    {
        get => _searchValue;
        set
        {
            _searchValue = value;
            ApplyFilter();
        }
    }



    private List<Lead> allLeads = new();
    private List<LeadSector> sectors = new();
    private List<Lead> leads = new();

    private Dictionary<string, List<Lead>> ByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var db = DbContextFactory.CreateDbContext();

        sectors = await db.LeadSectors.Distinct().ToListAsync();
        allLeads = await db.Leads
            .AsNoTracking()
            .Include(e => e.Origin)
            .Include(e => e.LeadRequest)
            .Include(e => e.Seller)
            .Include(e => e.Sector)
            .Include(e => e.Input)
            .Include(e => e.LeadState)
            .OrderByDescending(l=>l.LeadId)
            .ToListAsync();



        ApplyFilter();

    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(SearchValue))
        {
            leads = allLeads;
        }
        else
        {
            var search = SearchValue.Trim().ToLower();

            leads = allLeads.Where(l =>
                l.CompanyName!.ToLower().Contains(search) ||
                l.ContactName!.ToLower().Contains(search) ||
                l.Country!.ToLower().Contains(search) ||
                l.Seller.SellerName!.Contains(search) ||
                l.LeadRequest.RequestName!.ToLower().Contains(search) ||
                l.Sector!.Name!.ToLower().Contains(search)
            ).ToList();
        }

        BuildByCategory();
    }


    private void BuildByCategory()
    {
        ByCategory.Clear();

        foreach (var sector in sectors.Distinct().ToList())
        {
            var sectorLeads = leads
                .Where(l => l.LeadSectorId == sector.LeadSectorId)
                .ToList();

            if (sectorLeads.Any())
            {
                ByCategory[sector.Name] = sectorLeads;
            }
        }
    }

    private async Task ShowLeadComponent()
    {
        var parameters = new Dictionary<string, object>
        {
            {
                nameof(AddLeadComponent.OnAdded),
                EventCallback.Factory.Create(this, HandleLeadAdded)
            }
        };

        await offcanvas.ShowAsync<AddLeadComponent>(
            title: "Agregar Lead",
            parameters: parameters
        );
    }

    private async Task HandleLeadAdded()
    {
        await offcanvas.HideAsync();
        await LoadData();
        StateHasChanged();
    }

    private async Task HandleLeadSelected(Lead lead)
    {
        var parameters = new Dictionary<string, object>
        {
            { "Lead", lead }
        };

        await offcanvas.ShowAsync<LeadDetailComponent>(
            title: "Detalle del Lead",
            parameters: parameters
        );
    }
}
