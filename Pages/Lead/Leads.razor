@page "/leads"

@inject IDbContextFactory<ProjectsDBContext> DbContextFactory

<AuthorizeView Roles="administrador,ingeniero">
    <Authorized>
        <div class="d-flex justify-content-between align-items-center">
            <h3>Prospectos Recepción</h3>

            <button class="btn btn-primary" @onclick="ShowLeadComponent">
                Agregar Lead
            </button>
        </div>

        <hr />

        <Tabs>
            <Tab Title="Tabla" >
                <Content>
                    <TableLeadComponent Leads="leads" OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>

            <Tab Title="Etapas" Active="true">
                <Content>
                    <LeadKanban Leads="leads"
                                OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>
            <Tab Title="Reporte">
                <Content>
                    <LeadReportComponent OnSelect="HandleLeadSelected" />
                </Content>
            </Tab>
            <Tab Title="Sector">
                <Content>
                    <Tabs>
                        @foreach (var item in ByCategory)
                        {
                            <Tab Title="@item.Key">
                                <Content>
                                    <TableLeadComponent Leads="@item.Value" OnSelect="HandleLeadSelected" />
                                </Content>
                            </Tab>
                        }

                    </Tabs>
                </Content>
            </Tab>
        </Tabs>

        <Offcanvas @ref="offcanvas" />
    </Authorized>
    <NotAuthorized>

    </NotAuthorized>
</AuthorizeView>




@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success mt-3">
        @message
    </div>
}

@code {

    private Offcanvas offcanvas = default!;
    private string? message;


    private List<LeadSector> sectors = new();
    private List<Lead> leads = new();

    private Dictionary<string, List<Lead>> ByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var db = DbContextFactory.CreateDbContext();

        sectors = await db.LeadSectors.Distinct().ToListAsync();
        leads = await db.Leads
            .AsNoTracking()
            .Include(e => e.Origin)
            .Include(e => e.LeadRequest)
            .Include(e => e.Seller)
            .Include(e => e.Sector)
            .Include(e => e.Input)
            .Include(e => e.LeadState)
            .OrderByDescending(l=>l.LeadId)
            .ToListAsync();


        foreach (var sector in sectors)
        {
            var sectorLeads = leads
                .Where(l => l.LeadSectorId == sector.LeadSectorId)
                .ToList();

            if (sectorLeads.Any())
            {
                ByCategory[sector.Name] = sectorLeads;
            }
        }

    }

    private async Task ShowLeadComponent()
    {
        var parameters = new Dictionary<string, object>
        {
            {
                nameof(AddLeadComponent.OnAdded),
                EventCallback.Factory.Create(this, HandleLeadAdded)
            }
        };

        await offcanvas.ShowAsync<AddLeadComponent>(
            title: "Agregar Lead",
            parameters: parameters
        );
    }

    private async Task HandleLeadAdded()
    {
        await offcanvas.HideAsync();
        await LoadData();
        StateHasChanged();
    }

    private async Task HandleLeadSelected(Lead lead)
    {
        var parameters = new Dictionary<string, object>
        {
            { "Lead", lead }
        };

        await offcanvas.ShowAsync<LeadDetailComponent>(
            title: "Detalle del Lead",
            parameters: parameters
        );
    }
}
