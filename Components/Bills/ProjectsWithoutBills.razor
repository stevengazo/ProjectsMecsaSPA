@using ProjectsMecsaSPA.Utilities
@using static ProjectsMecsaSPA.Pages.Bill.BillsListPage

@inject IDbContextFactory<ProjectsDBContext> DbContextFactory
@inject IJSRuntime JS

<p class="fw-bold text-muted">
    Facturas correspondientes al año @SelectedYear.
    Se listan todos los proyectos creados en dicho período que no cuentan con facturas registradas activas.
</p>



@if (projectsWithoutBilling.Any())
{
    <button class="btn btn-sm btn-outline-success mb-2"
            @onclick="DownloadProjectsWithoutBill">
        Descargar Hoja de cálculo
    </button>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tarea</th>
                <th>Proyecto</th>
                <th>Estado</th>
                <th>Creación</th>
                <th>Monto Registrado</th>
                <th>Facturacion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in projectsWithoutBilling)
            {
                <tr>
                    <!-- Id del Proyecto-->
                    <td>
                        <a href="/projects/@item.ProjectId"
                           class="btn btn-sm btn-outline-success"
                           target="_blank">
                            @item.ProjectId
                        </a>
                    </td>
                    <!-- Numero de Tarea-->
                    <td>
                        <a href="https://grupomecsa.bitrix24.es/company/personal/user/107/tasks/task/view/@item.TaskNumber/"
                           class="btn btn-sm btn-outline-success"
                           target="_blank">
                            @item.TaskNumber
                        </a>
                    </td>
                    <!-- Nombre de Proyecto-->
                    <td>@item.ProjectName</td>
                    <!-- Estado-->
                    <td>@item.status</td>
                    <!-- Fecha de Creacion-->
                    <td>@item.CreationDate.ToShortDateString()</td>
                    <!-- Monto de Proyecto-->
                    @if (item.ProjectAmount == 0)
                    {
                        <td class="text-danger">@item.ProjectAmount.ToString("N2")</td>
                    }
                    else
                    {
                        <td>@item.ProjectAmount.ToString("N2")</td>
                    }
                    <!-- Estado-->
                    <td>
                        @if (item.billMark)
                        {
                            <label>Marcado como Facturado</label>
                        }
                        else
                        {
                            <label>No ha sido marcado como facturado</label>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No se encontraron proyectos sin facturación para el año seleccionado.
    </div>
}

@code {

    private List<ProjectBillSummary> projectsWithoutBilling = new();


    [Parameter]
    public int SelectedYear { get; set; } = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        LoadDataAsync();
        // return base.OnParametersSetAsync();
    }

    private async Task DownloadProjectsWithoutBill(MouseEventArgs args)
    {
        var data = await XmlsGenerate.GenerateFileProjects(projectsWithoutBilling);
        var fileBase64 = Convert.ToBase64String(data);

        await JS.InvokeVoidAsync(
            "downloadPDF",
            fileBase64,
            $"Proyectos_Sin_Facturas_{DateTime.Now:yyyyMMdd_HHmm}.xlsx"
        );
    }

    private async Task LoadDataAsync()
    {
        try
        {

            using var db = DbContextFactory.CreateDbContext();

            projectsWithoutBilling = await db.Projects
                .Include(p => p.State)
                .AsNoTracking()
                .Where(p =>
                    p.CreationDate.Year == SelectedYear &&
                    !db.Bill.Any(b =>
                        b.ProjectId == p.ProjectId &&
                        !b.IsDeleted
                    )
                    &&
                    !p.IsDeleted
                )
                .Select(p => new ProjectBillSummary
                {
                    ProjectId = p.ProjectId,
                    ProjectName = p.Title,
                    CreationDate = p.CreationDate,
                    ProjectAmount = p.Amount,
                    TaskNumber = p.TaskNumber,
                    status = p.State.StateName,
                    billMark = p.Isfactured,
                    BillsTotalAmount = 0
                })
                .OrderByDescending(p => p.ProjectId)
                .ToListAsync();
        }
        catch (Exception e)
        {

        }
        finally
        {
            StateHasChanged();
        }
    }
}
