@using ProjectsMecsaSPA.Model

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle mb-0">

        <thead class="table-light table-hover">
            <tr>
                <th>Contacto</th>
                <th>Cliente</th>
                <th>Vendedor</th>
                <th>Origen</th>
                <th>Solicitud</th>
                <th>Estado</th>
                <th>Deal</th>
                <th>Fecha Creación</th>
                <th>Nuevo</th>
                <th>Prioridad</th>
            </tr>
        </thead>

        <tbody>
            @if (Leads != null && Leads.Any())
            {
                @foreach (var l in Leads)
                {
                    <tr @onclick="() => OnSelect.InvokeAsync(l)">

                        <td class="fw-semibold">
                            @l.ContactName
                        </td>

                        <td>
                            @l.CompanyName
                        </td>

                        <td>
                            @l.Seller.SellerName
                        </td>

                        <td>
                            @l.Origin?.LeadOriginName
                        </td>

                        <td>
                            @l.LeadRequest?.RequestName
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                @l.LeadState?.Name
                            </span>
                        </td>

                        <td>
                            @l.DealNumber
                        </td>

                        <td class="text-nowrap">
                            @l.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td class="text-center">
                            <span class="badge @(l.IsNew ? "bg-success" : "bg-secondary")">
                                @(l.IsNew ? "Sí" : "No")
                            </span>
                        </td>

                        <td class="text-center">

                            @if (l.Prioritized == "Alta")
                            {
                                <span class="badge bg-danger">
                                    @l.Prioritized
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    @l.Prioritized
                                </span>
                            }
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-3">
                        No hay leads registrados
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>


@code {
    [Parameter]
    public List<Lead> Leads { get; set; } = new();
    [Parameter]
    public EventCallback<Lead> OnSelect { get; set; }
}
