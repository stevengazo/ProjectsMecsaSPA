@using ProjectsMecsaSPA.Model
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@inject Bitrix24ClientService Bitrix24Client
@inject IDbContextFactory<ProjectsDBContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider


<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />

@if (Lead == null)
{
    <div class="alert alert-secondary small text-center">
        No hay información del lead para mostrar.
    </div>
}
else
{
    <!-- ================= LEAD INFO ================= -->
    <div class="card mb-3 shadow-sm border-light rounded-3">

        <div class="card-header bg-white fw-bold">
            Información del Lead
        </div>



        @if (Editing)
        {

            <div class="card-body p-3">
                <EditForm Model="Lead">
                    <table class="table table-borderless table-sm mb-0 align-middle">
                        <tbody>
                            <tr>
                                <th class="text-muted small">ID</th>
                                <td class="fw-semibold">@Lead.LeadId</td>
                            </tr>
                            <!-- contact name -->
                            <tr>
                                <th class="text-muted small">Contacto</th>
                                <td>
                                    <InputText class="form-control form-control-sm"
                                               @bind-Value="Lead.ContactName" />
                                </td>
                            </tr>
                            <!-- Company name -->
                            <tr>
                                <th class="text-muted small">Cliente</th>
                                <td>
                                    <InputText class="form-control form-control-sm"
                                               @bind-Value="Lead.CompanyName" />
                                </td>
                            </tr>
                            <!-- Country -->
                            <tr>
                                <th class="text-muted small">País</th>
                                <td>
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="Lead.Country">
                                        <option value=""></option>
                                        <option value="Belice">Belice</option>
                                        <option value="Costa Rica">Costa Rica</option>
                                        <option value="El Salvador">El Salvador</option>
                                        <option value="Guatemala">Guatemala</option>
                                        <option value="Honduras">Honduras</option>
                                        <option value="México">México</option>
                                        <option value="Nicaragua">Nicaragua</option>
                                        <option value="Panamá">Panamá</option>
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- State -->
                            <tr>
                                <th class="text-muted small">Estado</th>
                                <td>
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="Lead.LeadStateId">
                                        @foreach (var i in States)
                                        {
                                            <option value="@i.LeadStateId">@i.Name</option>
                                        }

                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Request -->
                            <tr>
                                <th class="text-muted small">Tipo</th>
                                <td>
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="Lead.LeadRequestId">
                                        @foreach (var i in RequestTypes)
                                        {
                                            <option value="@i.LeadRequestId">@i.RequestName</option>
                                        }
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Entrada -->
                            <tr>
                                <th>
                                    <label class="form-label">Entrada</label>
                                </th>
                                <td>

                                    <InputSelect class="form-select form-select-sm" @bind-Value="Lead.LeadInputId">
                                        @foreach (var o in Inputs)
                                        {
                                            <option value="@o.LeadInputId">@o.Name</option>
                                        }
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Sector -->
                            <tr>
                                <th>
                                    <label class="form-label">Sector</label>
                                </th>
                                <td>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="Lead.LeadSectorId">
                                        @foreach (var o in sectors)
                                        {
                                            <option value="@o.LeadSectorId">@o.Name</option>
                                        }
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Origin -->
                            <tr>
                                <th>
                                    <label class="form-label">Origen</label>
                                </th>
                                <td>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="Lead.LeadOriginId">
                                        @foreach (var o in Origins)
                                        {
                                            <option value="@o.LeadOriginId">@o.LeadOriginName</option>
                                        }
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Vendedor -->
                            <tr>
                                <th class="text-muted small">Vendedor</th>
                                <td>
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="Lead.SellerId">
                                        @foreach (var i in Sellers)
                                        {
                                            <option value="@i.SellerId">@i.SellerName</option>
                                        }
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Task Bitrix -->
                            <tr>
                                <th class="text-muted small">Deal</th>
                                <td>

                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="Lead.DealNumber" />
                                </td>
                            </tr>
                            <!-- Priority -->
                            <tr>
                                <th class="text-muted small">Prioridad</th>
                                <td>
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="Lead.Prioritized">
                                        <option value="Alta">Alta</option>
                                        <option value="Media">Media</option>
                                        <option value="Baja">Baja</option>
                                    </InputSelect>
                                </td>
                            </tr>
                            <!-- Is New -->
                            <tr>
                                <th class="text-muted small">Nuevo</th>
                                <td>
                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="Lead.IsNew" />
                                </td>
                            </tr>
                            <!-- Createdby -->
                            <tr>
                                <th class="text-muted small">Creado por</th>
                                <td class="text-muted">@Lead.CreatedBy</td>
                            </tr>

                            <tr>
                                <th class="text-muted small">Creado</th>
                                <td class="text-muted">@Lead.CreatedAt</td>
                            </tr>

                            <tr>
                                <th class="text-muted small">Actualizado</th>
                                <td class="text-muted">@Lead.UpdatedAt</td>
                            </tr>

                            @if (!string.IsNullOrWhiteSpace(Lead.Description))
                            {
                                <tr>
                                    <th class="text-muted small align-top">Descripción</th>
                                    <td>
                                        <InputTextArea class="form-control form-control-sm"
                                                       rows="3"
                                                       @bind-Value="Lead.Description" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </EditForm>

            </div>
        }
        else
        {
            <div class="card-body p-3">
                <table class="table table-borderless table-sm mb-0 align-middle">
                    <tbody>
                        <tr><th class="text-muted">ID</th><td>@Lead.LeadId</td></tr>
                        <tr><th class="text-muted">Contacto</th><td>@Lead.ContactName</td></tr>
                        <tr><th class="text-muted">Empresa</th><td>@Lead.CompanyName</td></tr>

                        <tr><th class="text-muted">País</th><td>@Lead.Country</td></tr>

                        <tr>
                            <th class="text-muted">Estado</th>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @Lead.LeadState?.Name
                                </span>
                            </td>
                        </tr>
                        <tr><th class="text-muted">Sector</th><td>@Lead.Sector?.Name</td></tr>
                        <tr><th class="text-muted">Entrada</th><td>@Lead.Input?.Name</td></tr>
                        <tr><th class="text-muted">Origen</th><td>@Lead.Origin?.LeadOriginName</td></tr>
                        <tr><th class="text-muted">Tipo</th><td>@Lead.LeadRequest?.RequestName</td></tr>
                        <tr><th class="text-muted">Vendedor</th><td>@Lead.Seller?.SellerName</td></tr>
                        <tr>
                            <th class="text-muted">Deal</th>
                            <td>
                                <a href="https://grupomecsa.bitrix24.es/crm/deal/details/@Lead.DealNumber/" target="_blank">
                                    @Lead.DealNumber
                                </a>

                            </td>
                        </tr>

                        <tr>
                            <th class="text-muted">Prioridad</th>
                            <td>
                                <span class="badge bg-warning text-dark"> @Lead.Prioritized</span>

                            </td>
                        </tr>

                        <tr>
                            <th class="text-muted">Nuevo</th>
                            <td>
                                <span class="badge @(Lead.IsNew ? "bg-success" : "bg-secondary")">
                                    @(Lead.IsNew ? "Sí" : "No")
                                </span>
                            </td>
                        </tr>

                        <tr><th class="text-muted">Creado por</th><td>@Lead.CreatedBy</td></tr>
                        <tr><th class="text-muted">Creado</th><td>@Lead.CreatedAt</td></tr>
                        <tr><th class="text-muted">Actualizado</th><td>@Lead.UpdatedAt</td></tr>

                        @if (!string.IsNullOrWhiteSpace(Lead.Description))
                        {
                            <tr>
                                <th class="text-muted align-top">Descripción</th>
                                <td>@Lead.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        }




    </div>



    <!-- ================= Actions ================= -->
    <div class="card mb-3 shadow-sm border-0 rounded-3">

        <div class="card-header bg-light fw-semibold">
            Acciones
        </div>

        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">

                @if (!Editing)
                {
                    <Button class="btn btn-sm btn-primary px-3"
                            @onclick="SendMessage">
                        Notificar al Vendedor
                    </Button>
                }
                else
                {
                    <Button class="btn btn-sm ms-auto px-3 btn-success" @onclick="handleUpdate">
                        Guardar Cambios
                    </Button>
                }

                <Button class="@($"btn btn-sm ms-auto px-3 {deletebutton}")"
                        @onclick="HandleEditing">
                    @(Editing ? "Cancelar edición" : "Editar")
                </Button>



            </div>
        </div>
    </div>




    <!-- ================= NOTES ================= -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold">
            Notas del Lead
        </div>

        <div class="card-body">

            <!-- Formulario -->
            <EditForm Model="newNote" OnValidSubmit="AddNote">
                <div class="mb-3">
                    <InputTextArea class="form-control"
                                   rows="3"
                                   placeholder="Agregar nota..."
                                   @bind-Value="newNote.Notes" />
                </div>

                <button type="submit"
                        class="btn btn-primary btn-sm"
                        disabled="@string.IsNullOrWhiteSpace(newNote.Notes)">
                    Guardar nota
                </button>
            </EditForm>

            <hr />

            <!-- Listado -->
            @if (notes.Any())
            {
                @foreach (var n in notes.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="small text-muted mb-1">
                            @n.CreatedBy · @n.CreatedAt:dd/MM/yyyy HH:mm
                        </div>
                        <div>@n.Notes</div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted small">
                    No hay notas registradas.
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Lead Lead { get; set; } = default!;

    private ProjectsDBContext db = default!;
    private List<LeadNotes> notes = new();
    private LeadNotes newNote = new();
    private string? currentUser;
    private bool Editing = false;

    private List<LeadOrigin> Origins = new();
    private List<LeadRequest> RequestTypes = new();
    private List<Seller> Sellers = new();

    private List<LeadSector> sectors = new();
    private List<LeadInput> Inputs = new();
    private List<LeadState> States = new();

    private string deletebutton = "btn-success";

    List<ToastMessage> messages = new List<ToastMessage>();

    private ToastMessage CreateToastMessage(
        ToastType toastType,
        string title,
        string message,
        string? helpText = null)
    {
        return new ToastMessage
        {
            Type = toastType,
            Title = title,
            Message = message,
            HelpText = helpText ?? DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
        };
    }




    protected override async Task OnInitializedAsync()
    {
        db = DbContextFactory.CreateDbContext();
        await LoadUserAsync();



        await LoadData();
    }

    private async Task handleUpdate()
    {
        try
        {
            using var context = DbContextFactory.CreateDbContext();

            Lead.LeadState = States.FirstOrDefault(s => s.LeadStateId == Lead.LeadStateId);
            Lead.UpdatedAt = DateTime.Now;
            Lead.LastUpdatedBy = currentUser;
            context.Leads.Update(Lead);
            await context.SaveChangesAsync();

            Editing = false;
            deletebutton = "btn-success";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar Lead: {ex.Message}");
            // Aquí puedes integrar Toast / Snackbar si usas alguno
            throw;
        }
    }

    protected async Task HandleEditing()
    {
        Editing = !Editing;
        if (Editing)
        {
            deletebutton = "btn-danger";
        }
        else
        {
            deletebutton = "btn-success";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadData()
    {
        try
        {
            Origins = await db.LeadOrigins.AsNoTracking().OrderBy(o=>o.LeadOriginName).ToListAsync();
            RequestTypes = await db.LeadsRequest.AsNoTracking().OrderBy(o => o.RequestName).ToListAsync();
            Sellers = await db.Seller.AsNoTracking().Where(e=>e.IsActive).OrderBy(o => o.SellerName).ToListAsync();
            States = await db.LeadsState.AsNoTracking().OrderBy(o => o.Order).ToListAsync();
            sectors = await db.LeadSectors.AsNoTracking().OrderBy(e => e.Name).ToListAsync();
            Inputs = await db.LeadInput.AsNoTracking().OrderBy(e => e.Name).ToListAsync();
        }
        catch (Exception e)
        {

            throw e;
        }
    }

    private async Task LoadNotesAsync()
    {
        if (Lead == null) return;

        notes = await db.LeadNotes
            .Where(n => n.LeadId == Lead.LeadId)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task LoadUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = user.Identity.Name;
        }
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(newNote.Notes)) return;

        newNote.LeadId = Lead.LeadId;
        newNote.CreatedBy = currentUser;
        newNote.CreatedAt = DateTime.Now;

        db.LeadNotes.Add(newNote);
        await db.SaveChangesAsync();

        notes.Insert(0, newNote);
        newNote = new();
    }

    private async Task SendMessage()
    {
        var message = $@"
📌 Nueva Solicitud Entrante en Recepción

• Nombre: {Lead.ContactName}
• Empresa: {Lead.CompanyName}

• Origen: {Lead?.Origin.LeadOriginName}
• Solicitud: {Lead?.LeadRequest.RequestName}
• Estado: {Lead.LeadState?.Name}

• Negociación https://grupomecsa.bitrix24.es/crm/deal/details/{Lead.DealNumber}/

• Vendedor asignado: {Lead.Seller.SellerName}

🗓 Fecha de creación: {Lead.CreatedAt:dd/MM/yyyy HH:mm}
👤 Creado por: {currentUser}

Descripción
{Lead.Description}


-------
(Este es un mensaje automático)
";
        var respo = await Bitrix24Client.SendMessageToUser(Lead.Seller.Bitrix24Id, message);
        if (respo != 0)
        {
            messages.Add(CreateToastMessage(ToastType.Success, "Éxito", "Mensaje enviado al vendedor correctamente."));
        }
        else
        {
            messages.Add(CreateToastMessage(ToastType.Danger, "Error", "No se pudo enviar el mensaje al vendedor."));
        }
    }
}
