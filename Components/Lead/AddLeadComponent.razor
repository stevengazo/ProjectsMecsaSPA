@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ProjectsDBContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Agregar Lead</h3>

<EditForm Model="@Lead" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Cliente -->
    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <InputText class="form-control" @bind-Value="Lead.CompanyName" />
    </div>

    <!-- Nombre de contacto -->
    <div class="mb-3">
        <label class="form-label">Nombre del contacto</label>
        <InputText class="form-control" @bind-Value="Lead.ContactName" />
    </div>

    <!-- Descripción -->
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <InputTextArea class="form-control" @bind-Value="Lead.Description" />
    </div>

    <!-- Número de negocio -->
    <div class="mb-3">
        <label class="form-label">Número de negocio</label>
        <InputNumber class="form-control" @bind-Value="Lead.DealNumber" />
    </div>

    <!-- Prioridad -->
    <div class="mb-3">
        <label class="form-label">Prioridad</label>
        <InputSelect class="form-select" @bind-Value="Lead.Prioritized">
            <option value="">Seleccione...</option>
            <option value="Alta">Alta</option>
            <option value="Media">Media</option>
            <option value="Baja">Baja</option>
        </InputSelect>
    </div>

    <!-- Origen -->
    <div class="mb-3">
        <label class="form-label">Origen</label>
        <InputSelect class="form-select" @bind-Value="Lead.LeadOriginId">
            <option value="0">Seleccione...</option>
            @foreach (var o in origins)
            {
                <option value="@o.LeadOriginId">@o.LeadOriginName</option>
            }
        </InputSelect>
    </div>

    <!-- Entrada -->
    <div class="mb-3">
        <label class="form-label">Entrada</label>
        <InputSelect class="form-select" @bind-Value="Lead.LeadInputId">
            <option value="0">Seleccione...</option>
            @foreach (var i in inputs)
            {
                <option value="@i.LeadInputId">@i.Name</option>
            }
        </InputSelect>
    </div>

    <!-- Sector -->
    <div class="mb-3">
        <label class="form-label">Sector</label>
        <InputSelect class="form-select" @bind-Value="Lead.LeadSectorId">
            <option value="0">Seleccione...</option>
            @foreach (var s in sectors)
            {
                <option value="@s.LeadSectorId">@s.Name</option>
            }
        </InputSelect>
    </div>

    <!-- Tipo de solicitud -->
    <div class="mb-3">
        <label class="form-label">Tipo de solicitud</label>
        <InputSelect class="form-select" @bind-Value="Lead.LeadRequestId">
            <option value="0">Seleccione...</option>
            @foreach (var r in requests)
            {
                <option value="@r.LeadRequestId">@r.RequestName</option>
            }
        </InputSelect>
    </div>

    <!-- Vendedor -->
    @if (sellers.Any())
    {
        <div class="mb-3">
            <label class="form-label">Vendedor</label>
            <InputSelect class="form-select" @bind-Value="Lead.SellerId">
                <option value="0">Seleccione...</option>
                @foreach (var s in sellers)
                {
                    <option value="@s.SellerId">@s.SellerName</option>
                }
            </InputSelect>
        </div>
    }
    else
    {
        <div class="text-muted mb-3">No hay vendedores disponibles</div>
    }

    <!-- País -->
    <div class="mb-3">
        <label class="form-label">País</label>
        <InputSelect class="form-select" @bind-Value="Lead.Country">
            <option value="">Seleccione...</option>
            <option value="Belice">Belice</option>
            <option value="Costa Rica">Costa Rica</option>
            <option value="El Salvador">El Salvador</option>
            <option value="Guatemala">Guatemala</option>
            <option value="Honduras">Honduras</option>
            <option value="México">México</option>
            <option value="Nicaragua">Nicaragua</option>
            <option value="Panamá">Panamá</option>
        </InputSelect>
    </div>

    <!-- Estado fijo: Nuevo -->
    <div class="mb-3">
        <label class="form-label">Estado</label>
        <InputSelect class="form-select" @bind-Value="Lead.LeadStateId" disabled>
            @foreach (var s in states)
            {
                <option value="@s.LeadStateId">@s.Name</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-success">
        Agregar
    </button>
</EditForm>

@code {
    [Parameter] public EventCallback OnAdded { get; set; }

    private Lead Lead = new();

    private List<LeadOrigin> origins = new();
    private List<LeadRequest> requests = new();
    private List<Seller> sellers = new();
    private List<LeadState> states = new();
    private List<LeadSector> sectors = new();
    private List<LeadInput> inputs = new();

    private string? currentUser;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
        await LoadDataAsync();

        Lead.CreatedAt = DateTime.UtcNow;
        Lead.UpdatedAt = DateTime.UtcNow;
        Lead.CompanyName = "";
        Lead.ContactName = "";
        Lead.Description = "";
        Lead.IsNew = true;
        Lead.isDeleted = false;
       Lead.LeadStateId = 1; // Nuevo
    }

    private async Task LoadDataAsync()
    {
        using var db = DbContextFactory.CreateDbContext();
        origins = await db.LeadOrigins.AsNoTracking().OrderBy(x => x.LeadOriginName).ToListAsync();
        requests = await db.LeadsRequest.AsNoTracking().OrderBy(x => x.RequestName).ToListAsync();
        states = await db.LeadsState.AsNoTracking().OrderBy(x => x.Order).ToListAsync();
        sellers = await db.Seller.AsNoTracking().OrderBy(x => x.SellerName).ToListAsync();
        sectors = await db.LeadSectors.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        inputs = await db.LeadInput.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    private async Task LoadUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = user.Identity.Name;
        }
    }

    private async Task SaveAsync()
    {
        using var db = DbContextFactory.CreateDbContext();

        Lead.CreatedBy = currentUser ?? "system";
        Lead.LastUpdatedBy = currentUser ?? "system";
        Lead.UpdatedAt = DateTime.UtcNow;

        db.Leads.Add(Lead);
        await db.SaveChangesAsync();

        if (OnAdded.HasDelegate)
        {
            await OnAdded.InvokeAsync();
        }
    }
}
